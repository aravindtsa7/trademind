{
  "name": "trademind-backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --ignore-watch node_modules src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write .",
    "prisma:validate": "prisma validate",
    "test:market-data": "tsx src/tests/test-market-data.ts",
    "test:historical-candles": "tsx src/tests/test-historical-candles.ts",
    "test:indicator-engine": "tsx src/tests/test-indicator-engine.ts",
    "test:live-paper-trading": "tsx src/tests/test-live-paper-trading.ts",
    "paper:v1": "tsx src/tests/test-live-paper-trading.ts",
    "paper:v2": "tsx src/tests/test-live-paper-trading-v2.ts",
    "shadow:v4:momentum": "tsx src/tests/test-live-v4-nifty-momentum-shadow-entry.ts",
    "research:v8:freeze": "set RESEARCH_LOCAL_ONLY=true&& set V8_TRAIN_ONLY_FREEZE=true&& tsx src/tests/test-v8-nifty-bullish-reclaim-outcomes.ts",
    "shadow:v8:reclaim": "tsx src/tests/test-live-v8-nifty-bullish-reclaim-shadow-entry.ts",
    "report:forward-validation": "tsx src/tests/report-forward-validation.ts",
    "collect:v12:order-flow": "tsx src/tests/collect-v12-nifty-option-order-flow.ts",
    "replay:record": "tsx src/tests/replay-record-help.ts",
    "replay:session": "tsx src/tests/replay-market-session.ts",
    "replay:verify": "tsx src/tests/replay-market-session.ts --verify",
    "research:nifty-history": "tsx src/tests/research-nifty-underlying-acquisition.ts",
    "research:nifty-contract-catalog": "tsx src/tests/research-nifty-contract-catalog.ts",
    "research:nifty-option-candles": "tsx src/tests/research-nifty-option-candle-acquisition.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.13.1",
    "axios": "^1.19.0",
    "bullmq": "^6.0.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.4",
    "protobufjs": "^8.7.1",
    "redis": "^6.2.0",
    "winston": "^3.9.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.18",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.10.0",
    "@typescript-eslint/parser": "^7.10.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.0",
    "prisma": "^5.13.1",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.7",
    "typescript": "^5.6.0"
  }
}

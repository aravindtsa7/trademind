{
  "name": "trademind-backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --ignore-watch node_modules src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write .",
    "prisma:validate": "prisma validate",
    "test:market-data": "tsx src/tests/test-market-data.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.13.1",
    "axios": "^1.19.0",
    "bullmq": "^6.0.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.4",
    "protobufjs": "^8.7.1",
    "redis": "^6.2.0",
    "winston": "^3.9.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.18",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.10.0",
    "@typescript-eslint/parser": "^7.10.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.0",
    "prisma": "^5.13.1",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.7",
    "typescript": "^5.6.0"
  }
}

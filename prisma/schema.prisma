generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Instrument {
  id               String   @id @default(uuid())
  instrumentKey    String   @unique
  exchange         String
  segment          String
  underlyingSymbol String
  tradingSymbol    String
  instrumentType   String
  expiry           DateTime
  strikePrice      Decimal
  lotSize          Int
  tickSize         Decimal
  weekly           Boolean  @default(false)
  isin             String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([underlyingSymbol])
  @@index([expiry])
  @@index([instrumentType])
  @@index([strikePrice])
  @@index([underlyingSymbol, expiry])
  @@index([underlyingSymbol, instrumentType])
}

model InstrumentSyncLog {
  id           String    @id @default(uuid())
  startedAt    DateTime
  completedAt  DateTime?
  durationMs   Int?
  downloaded   Int       @default(0)
  filtered     Int       @default(0)
  inserted     Int       @default(0)
  updated      Int       @default(0)
  inactivated  Int       @default(0)
  status       String
  errorMessage String?
  createdAt    DateTime  @default(now())
}

model HistoricalCandle {
  id             String   @id @default(uuid())
  instrumentKey  String
  timeframe      String
  candleTime     DateTime
  open           Decimal
  high           Decimal
  low            Decimal
  close          Decimal
  volume         BigInt
  openInterest   BigInt?
  source         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([instrumentKey, timeframe, candleTime])
  @@index([instrumentKey])
  @@index([timeframe])
  @@index([candleTime])
  @@index([instrumentKey, timeframe])
  @@index([instrumentKey, timeframe, candleTime])
}

model HistoricalCandleSyncLog {
  id            String    @id @default(uuid())
  instrumentKey String
  timeframe     String
  startedAt     DateTime
  completedAt   DateTime?
  downloaded    Int       @default(0)
  inserted      Int       @default(0)
  updated       Int       @default(0)
  durationMs    Int?
  status        String
  errorMessage  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([instrumentKey])
  @@index([timeframe])
  @@index([status])
  @@index([startedAt])
}

model HistoricalOptionCandle {
  id            String   @id @default(uuid())
  instrumentKey String
  tradingSymbol String?
  optionType    String?
  strikePrice   Decimal?
  expiry        DateTime?
  timeframe     String
  candleTime    DateTime
  open          Decimal
  high          Decimal
  low           Decimal
  close         Decimal
  volume        BigInt
  openInterest  BigInt?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([instrumentKey, timeframe, candleTime])
  @@index([instrumentKey, timeframe])
  @@index([candleTime])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Instrument {
  id               String   @id @default(uuid())
  instrumentKey    String   @unique
  exchange         String
  segment          String
  underlyingSymbol String
  tradingSymbol    String
  instrumentType   String
  expiry           DateTime
  strikePrice      Decimal
  lotSize          Int
  tickSize         Decimal
  weekly           Boolean  @default(false)
  isin             String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([underlyingSymbol])
  @@index([expiry])
  @@index([instrumentType])
  @@index([strikePrice])
  @@index([underlyingSymbol, expiry])
  @@index([underlyingSymbol, instrumentType])
}

model InstrumentSyncLog {
  id           String    @id @default(uuid())
  startedAt    DateTime
  completedAt  DateTime?
  durationMs   Int?
  downloaded   Int       @default(0)
  filtered     Int       @default(0)
  inserted     Int       @default(0)
  updated      Int       @default(0)
  inactivated  Int       @default(0)
  status       String
  errorMessage String?
  createdAt    DateTime  @default(now())
}

model HistoricalCandle {
  id             String   @id @default(uuid())
  instrumentKey  String
  timeframe      String
  candleTime     DateTime
  open           Decimal
  high           Decimal
  low            Decimal
  close          Decimal
  volume         BigInt
  openInterest   BigInt?
  source         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([instrumentKey, timeframe, candleTime])
  @@index([instrumentKey])
  @@index([timeframe])
  @@index([candleTime])
  @@index([instrumentKey, timeframe])
  @@index([instrumentKey, timeframe, candleTime])
}

// B-F2C: durable, non-secret evidence that a research-lake historical
// provider retrieval was attempted, created BEFORE the provider is ever
// called (see NiftyUnderlyingAcquisitionService) so a crash mid-retrieval
// leaves a truthful STARTED/FETCHED row rather than silently claiming
// accepted data that was never durably persisted. One row per LOGICAL
// provider request (a monthly chunk), never one row per internal HTTP
// retry -- `providerCallAttempts` records the truthful total attempt count
// for that one logical retrieval. Never stores an access token, API
// secret, Authorization header, or Axios config.
model HistoricalDataRetrieval {
  id                         String    @id @default(uuid())
  providerId                 String
  assetType                  String
  instrumentKey              String
  timeframe                  String
  requestedFromDate          String
  requestedToDate            String
  status                     String
  startedAt                  DateTime
  completedAt                DateTime?
  providerCallAttempts       Int       @default(0)
  sourceRowCount             Int?
  sourceRowsSemanticChecksum String?
  errorCategory              String?
  errorCode                  String?
  errorMessage               String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  sessions                   HistoricalDataRetrievalSession[]

  @@index([instrumentKey, timeframe])
  @@index([status])
  @@index([startedAt])
}

// One trading-session's durable acceptance/conflict/exclusion evidence
// within a parent `HistoricalDataRetrieval` (one provider request commonly
// spans many trading dates -- acceptance is always decided per session).
// `evidenceSemanticChecksum` deliberately excludes `id`/`retrievalId`/
// `createdAt`/`updatedAt` so two semantically-identical retrievals (e.g. a
// re-run against unchanged provider content) produce the IDENTICAL
// checksum despite different wall-clock timestamps/random IDs -- this is
// the value a dataset manifest can safely reference without perturbing its
// own deterministic content identity.
model HistoricalDataRetrievalSession {
  id                         String   @id @default(uuid())
  retrievalId                String
  instrumentKey              String
  timeframe                  String
  tradingDate                String
  calendarDisposition        String
  expectedMinuteCount        Int
  providerRowCountForDate    Int
  acceptedRowCount           Int
  excludedRowCount           Int
  sourceOrderAnomalyCount    Int
  healthStatus               String
  persistenceOutcome         String
  sourceRowsSemanticChecksum String?
  canonicalContentChecksum   String?
  evidenceSemanticChecksum   String
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  retrieval                  HistoricalDataRetrieval @relation(fields: [retrievalId], references: [id], onDelete: Cascade)
  conflicts                  HistoricalCandleConflict[]
  repairAttemptsAsPrimary    HistoricalCandleRepairEvidence[] @relation("RepairPrimarySession")
  repairAttemptsAsResult     HistoricalCandleRepairEvidence[] @relation("RepairResultingSession")

  @@unique([retrievalId, tradingDate])
  @@index([instrumentKey, timeframe, tradingDate])
  @@index([persistenceOutcome])
}

// One conflicting logical candle: the already-persisted `HistoricalCandle`
// content disagreed with a new provider retrieval's content for the exact
// same (instrumentKey, timeframe, candleTime) identity. Durable, queryable
// evidence that the research persistence path fails closed on -- it NEVER
// overwrites `HistoricalCandle` when this row is written (see
// HistoricalCandleResearchPersistenceService). No secrets are ever stored
// here (candle OHLCVOI values only).
model HistoricalCandleConflict {
  id                      String   @id @default(uuid())
  retrievalSessionId      String
  instrumentKey           String
  timeframe               String
  candleTime              DateTime
  existingOpen            Decimal
  existingHigh            Decimal
  existingLow             Decimal
  existingClose           Decimal
  existingVolume          BigInt
  existingOpenInterest    BigInt?
  incomingOpen            Decimal
  incomingHigh            Decimal
  incomingLow             Decimal
  incomingClose           Decimal
  incomingVolume          BigInt
  incomingOpenInterest    BigInt?
  existingContentChecksum String
  incomingContentChecksum String
  detectedAt              DateTime @default(now())
  retrievalSession        HistoricalDataRetrievalSession @relation(fields: [retrievalSessionId], references: [id], onDelete: Cascade)

  @@index([instrumentKey, timeframe, candleTime])
  @@index([retrievalSessionId])
}

// B-F8: durable, append-only composite provenance for one canonical-session
// GAP-REPAIR attempt -- combining a primary retrieval's accepted rows with
// an explicitly-configured secondary repair provider's rows for exactly the
// authoritative canonical minutes the primary retrieval left missing (see
// NiftyUnderlyingGapRepairService). One row per repair ATTEMPT; the SERVICE
// WRITE PATH (`HistoricalCandleRepairEvidenceService`) is create-only --
// reruns append a new row rather than revising or deleting an old one,
// exactly like every other B-F2C evidence table.
//
// LOW 5 CORRECTION (post-Terra-review): "append-only" here is a SERVICE
// CONVENTION, not a database-permanent/cryptographic retention guarantee --
// `primarySessionId`'s FK is `onDelete: Cascade` (see below), so deleting
// the parent `HistoricalDataRetrievalSession` DOES cascade-delete this row
// (and its `HistoricalCandleRepairSessionWindow`/`HistoricalCandleRepairContribution`
// children in turn). This is the SAME pre-existing convention every other
// B-F2C evidence table already uses (e.g. `HistoricalCandleConflict`'s
// `retrievalSessionId` FK is also `onDelete: Cascade`) -- no production code
// path in this repository ever deletes a `HistoricalDataRetrievalSession`
// today, but this doc deliberately no longer overclaims an immutability
// guarantee the schema itself does not enforce. `primarySessionId`
// always references the (INCOMPLETE, or occasionally INVALID) primary
// `HistoricalDataRetrievalSession` this attempt targeted; `resultingSessionId`
// references the NEW composite ACCEPTED session only when `outcome` is
// REPAIR_ACCEPTED (null for every other outcome -- a failed/declined repair
// attempt never fabricates a resulting session). `primaryRetrievalId` /
// `repairRetrievalId` are intentionally plain, non-FK-enforced identifiers
// (not `@relation`) -- they are denormalized convenience pointers into
// `HistoricalDataRetrieval`, exactly mirroring how `HistoricalCandleConflict`
// already denormalizes `instrumentKey`/`timeframe` alongside its own FK;
// `primarySessionId`/`resultingSessionId` remain the enforced relational
// links. Never stores an access token, API secret, or raw candle payload.
model HistoricalCandleRepairEvidence {
  id                        String                          @id @default(uuid())
  primaryRetrievalId        String
  // Nullable at the DB level ONLY because a legacy row written before this column existed cannot
  // truthfully populate it (see the migration's own doc comment) -- application code
  // (`HistoricalCandleRepairEvidenceService.recordRepairAttempt`) always supplies a value for every
  // row it creates; `RecordRepairAttemptInput.primaryProviderId` remains required (non-null) in
  // TypeScript. `HistoricalDataRetrievalEvidenceService.findLatestAvailableSessionEvidence` requires
  // this (and `calendarDisposition`/`repairPolicyVersion`) to be non-null before treating a row as
  // full composite provenance, so a legacy NULL row is fail-closed rather than fabricated.
  primaryProviderId         String?
  primarySessionId          String
  repairProviderId          String
  repairRetrievalId         String?
  instrumentKey             String
  timeframe                 String
  tradingDate                String
  // Nullable at the DB level for the same legacy-row reason as `primaryProviderId` above.
  calendarDisposition       String?
  // Nullable at the DB level for the same legacy-row reason as `primaryProviderId` above.
  repairPolicyVersion       Int?
  expectedMinuteCount       Int
  primaryAcceptedRowCount   Int
  missingMinuteCount        Int
  repairAcceptedMinuteCount Int
  corroboratedOverlapCount  Int
  conflictingOverlapCount   Int
  outcome                   String
  resultingSessionId        String?
  missingMinutesChecksum    String
  repairSemanticChecksum    String
  createdAt                 DateTime                          @default(now())
  primarySession            HistoricalDataRetrievalSession    @relation("RepairPrimarySession", fields: [primarySessionId], references: [id], onDelete: Cascade)
  resultingSession          HistoricalDataRetrievalSession?   @relation("RepairResultingSession", fields: [resultingSessionId], references: [id], onDelete: SetNull)
  sessionWindows            HistoricalCandleRepairSessionWindow[]
  contributions             HistoricalCandleRepairContribution[]

  @@index([instrumentKey, timeframe, tradingDate])
  @@index([primarySessionId])
  @@index([resultingSessionId])
  @@index([outcome])
}

// B-F8 CORRECTION: the exact, authoritative calendar session window(s) that
// governed ONE repair attempt, stored normalized (mirrors
// `ExchangeCalendarSessionWindow`'s established shape/spirit, never a JSON
// blob) so the full expected-canonical-minute vector for that attempt can be
// deterministically re-derived offline via the existing pure
// `expectedMinutesForWindows`/`expectedCanonicalTimestamps` utilities --
// without any future calendar lookup or provider re-fetch. Immutable once
// written (one repair attempt's windows never change after the fact).
model HistoricalCandleRepairSessionWindow {
  id               String                         @id @default(uuid())
  repairEvidenceId String
  windowIndex      Int
  openMinuteIst    Int
  closeMinuteIst   Int
  createdAt        DateTime                       @default(now())
  repairEvidence   HistoricalCandleRepairEvidence @relation(fields: [repairEvidenceId], references: [id], onDelete: Cascade)

  @@unique([repairEvidenceId, windowIndex])
}

// B-F8 CORRECTION: durable, per-canonical-timestamp contribution provenance
// for one repair attempt -- answers "which exact canonical timestamps came
// from the repair provider, which were corroborated overlaps, and which were
// conflicting overlaps" directly from DB state, without ever requiring a
// future provider re-fetch (a SHA-256 checksum alone is not invertible).
// Deliberately does NOT store one row per every primary-retained minute
// (task correction: "do not blindly store 375 redundant rows") -- a
// primary-owned timestamp is instead the set difference between the
// attempt's own `HistoricalCandleRepairSessionWindow`-derived expected
// minute vector and this table's `REPAIR_FILLED_MISSING` rows for the same
// `repairEvidenceId`, which is exactly and only valid to reconstruct when
// the parent's `outcome` is `REPAIR_ACCEPTED` (a full, complete resolution).
// Append-only; one row per (repairEvidenceId, candleTime, role).
model HistoricalCandleRepairContribution {
  id                      String                         @id @default(uuid())
  repairEvidenceId        String
  candleTime              DateTime
  role                    String
  repairProviderId        String
  repairRetrievalId       String?
  repairContentChecksum   String
  primaryContentChecksum  String?
  createdAt               DateTime                       @default(now())
  repairEvidence          HistoricalCandleRepairEvidence @relation(fields: [repairEvidenceId], references: [id], onDelete: Cascade)

  @@unique([repairEvidenceId, candleTime, role])
  @@index([repairEvidenceId])
  @@index([candleTime])
}

model HistoricalCandleSyncLog {
  id            String    @id @default(uuid())
  instrumentKey String
  timeframe     String
  startedAt     DateTime
  completedAt   DateTime?
  downloaded    Int       @default(0)
  inserted      Int       @default(0)
  updated       Int       @default(0)
  durationMs    Int?
  status        String
  errorMessage  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([instrumentKey])
  @@index([timeframe])
  @@index([status])
  @@index([startedAt])
}

model HistoricalOptionCandle {
  id            String   @id @default(uuid())
  instrumentKey String
  tradingSymbol String?
  optionType    String?
  strikePrice   Decimal?
  expiry        DateTime?
  timeframe     String
  candleTime    DateTime
  open          Decimal
  high          Decimal
  low           Decimal
  close         Decimal
  volume        BigInt
  openInterest  BigInt?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([instrumentKey, timeframe, candleTime])
  @@index([instrumentKey, timeframe])
  @@index([candleTime])
}

// B-F3: point-in-time historical option-contract catalog (discovery only,
// no candle data). Deliberately separate from `Instrument` (current-state
// live master, must never stand in for historical truth of an expired
// contract) and from `HistoricalOptionCandle` (candle rows, not identity).
// `provider` + `providerContractId` is the idempotency key: the provider's
// own native contract identifier, never `expiry`+`strikePrice`+`optionType`
// alone, which could collide across providers/underlyings/exchanges.
// `exchangeTradingSymbol` / `lotSize` / `tickSize` are nullable because
// discovery alone frequently cannot prove them; `metadataState` records
// whether B-F1's identity-completeness contract was actually satisfied
// (CATALOG_KNOWN) or not (METADATA_INCOMPLETE) -- this table never stores
// OBSERVED_TRADING/SESSION_COVERED, those require candle evidence (B-F4+).
model HistoricalOptionContractCatalog {
  id                    String    @id @default(uuid())
  provider              String
  providerContractId    String
  underlyingSymbol      String
  exchange              String
  expiry                DateTime
  strikePrice           Decimal
  optionType            String
  exchangeTradingSymbol String?
  lotSize               Int?
  tickSize              Decimal?
  metadataState         String
  discoveredAt          DateTime
  sourceCatalogAsOf     DateTime
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([provider, providerContractId])
  @@index([underlyingSymbol, exchange])
  @@index([expiry])
  @@index([optionType])
  @@index([metadataState])
}

// Durable broker-neutral execution audit.  Paper execution uses this schema
// through the execution repository deployment adapter; no broker credentials
// or order-routing fields are persisted here.
model ExecutionOrder {
  executionOrderId          String   @id
  intentId                  String   @unique
  strategyId                String
  runtimeId                 String
  sessionDate               String
  instrumentKey             String
  side                      String
  quantity                  Int
  requestedPrice            Decimal? @db.Decimal(20, 8)
  executionMode             String
  status                    String
  cumulativeFilledQuantity  Int      @default(0)
  cumulativeExitQuantity    Int      @default(0)
  remainingQuantity         Int
  averageFillPrice          Decimal? @db.Decimal(20, 8)
  averageExitPrice          Decimal? @db.Decimal(20, 8)
  correlationId             String
  version                   Int      @default(0)
  externalOrderId           String?  @unique
  paperOrderId              String?  @unique
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  fills                     ExecutionFill[]
  transitions               ExecutionStateTransition[]
  paperPosition             PaperPortfolioPosition?

  @@index([sessionDate, status])
  @@index([strategyId, sessionDate])
  @@index([instrumentKey, sessionDate])
}

model PaperPortfolioPosition {
  positionId          String   @id
  executionOrderId    String   @unique
  originatingIntentId String   @unique
  originatingOrderId  String   @unique
  strategyId          String
  sessionDate         String
  instrumentKey       String
  underlying          String
  side                String
  quantity            Int
  entryTimestamp      DateTime
  entryPrice          Decimal  @db.Decimal(20, 8)
  currentMarkPrice    Decimal? @db.Decimal(20, 8)
  realizedPnl         Decimal  @default(0) @db.Decimal(20, 8)
  unrealizedPnl       Decimal? @db.Decimal(20, 8)
  status              String
  correlationId       String
  exitTimestamp       DateTime?
  exitPrice           Decimal? @db.Decimal(20, 8)
  exitReason          String?
  stateVersion        Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  executionOrder      ExecutionOrder @relation(fields: [executionOrderId], references: [executionOrderId], onDelete: Restrict)
  fills               PaperPortfolioFill[]

  @@index([sessionDate, status])
  @@index([strategyId, sessionDate])
  @@index([instrumentKey, sessionDate])
}

model PaperPortfolioFill {
  paperFillId       String   @id
  positionId        String
  executionFillId  String   @unique
  type              String
  timestamp         DateTime
  price             Decimal  @db.Decimal(20, 8)
  quantity          Int
  source            String
  exitReason        String?
  fillQuality       String?
  slippage          Decimal? @db.Decimal(20, 8)
  createdAt         DateTime @default(now())
  position          PaperPortfolioPosition @relation(fields: [positionId], references: [positionId], onDelete: Cascade)

  @@index([positionId, timestamp])
}

model ExecutionFill {
  fillId           String   @id
  executionOrderId String
  leg              String
  quantity         Int
  price            Decimal  @db.Decimal(20, 8)
  timestamp        DateTime
  source           String
  quoteQuality     String
  slippage         Decimal  @db.Decimal(20, 8)
  correlationId    String
  createdAt        DateTime @default(now())
  order            ExecutionOrder @relation(fields: [executionOrderId], references: [executionOrderId], onDelete: Cascade)

  @@index([executionOrderId, timestamp])
}

// B-F7A CORE: authoritative, provider-agnostic exchange trading-calendar
// truth. Deliberately separate from any live `nse-session-calendar.service.ts`
// runtime code (out of scope for this pass) and from Upstox/Groww identifiers
// (exchange/segment are stable domain concepts, never provider-coupled).
//
// Coverage versions are year-scoped. `coverageFrom`/`coverageTo` remain
// explicit because a current-year snapshot may certify only part of its
// `calendarYear`; application validation requires both boundaries to belong
// to that year. Version identity is therefore
// `(exchange, segment, calendarYear, version)`.
model ExchangeCalendarCoverage {
  id                   String                           @id @default(uuid())
  exchange             String
  segment              String
  calendarYear         Int
  coverageFrom         DateTime
  coverageTo           DateTime
  version              Int
  status               String
  sourceAuthority      String
  sourceBundleChecksum String
  createdAt            DateTime                         @default(now())
  updatedAt            DateTime                         @updatedAt
  sourceDocuments      ExchangeCalendarSourceDocument[]
  days                 ExchangeCalendarDay[]

  @@unique([exchange, segment, calendarYear, version])
  @@index([exchange, segment, calendarYear, status])
  @@index([exchange, segment, calendarYear, coverageFrom, coverageTo])
}

// Stable serialization target for certification/activation. Repository code
// ensures this exact scope row exists, locks it with SELECT ... FOR UPDATE,
// then performs the complete DRAFT/CERTIFIED/DEPRECATED transition atomically.
model ExchangeCalendarScopeLock {
  id           String   @id @default(uuid())
  exchange     String
  segment      String
  calendarYear Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([exchange, segment, calendarYear])
}

// One official NSE source document contributing to a coverage version's
// provenance. A coverage version is deliberately allowed 1..N of these (task
// correction: a year's calendar truth may derive from an annual circular PLUS
// amendments/extraordinary-closure notices/special-session circulars) --
// never modeled as exactly one circular per version.
model ExchangeCalendarSourceDocument {
  id                    String                   @id @default(uuid())
  coverageId            String
  documentReference     String
  documentType          String
  contentChecksumSha256 String
  referenceUrl          String?
  createdAt             DateTime                 @default(now())
  coverage              ExchangeCalendarCoverage @relation(fields: [coverageId], references: [id], onDelete: Cascade)
  days                  ExchangeCalendarDay[]

  @@unique([coverageId, documentReference])
}

// One explicit, authoritative date definition within a coverage version.
// Only ever holds the classifications that can be authoritatively declared
// (`REGULAR_SESSION` / `EXCHANGE_HOLIDAY` / `SPECIAL_SESSION` /
// `EXCEPTIONAL_CLOSURE`) -- `WEEKEND` and `UNCERTIFIED` are never persisted
// rows, they are always resolver-inferred (see
// `exchange-calendar-resolution.types.ts`). `sourceDocumentId` remains
// nullable only because explicit REGULAR_SESSION attribution is optional;
// application validation requires it for every explicit holiday, special
// session, and exceptional closure.
model ExchangeCalendarDay {
  id               String                          @id @default(uuid())
  coverageId       String
  tradingDate      DateTime
  classification   String
  reason           String?
  sourceDocumentId String?
  createdAt        DateTime                        @default(now())
  coverage         ExchangeCalendarCoverage        @relation(fields: [coverageId], references: [id], onDelete: Cascade)
  sourceDocument   ExchangeCalendarSourceDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict)
  windows          ExchangeCalendarSessionWindow[]

  @@unique([coverageId, tradingDate])
  @@index([tradingDate])
  @@index([sourceDocumentId])
}

// One deterministic session window for an explicit `SPECIAL_SESSION` day.
// Canonical representation only: `openMinuteIst`/`closeMinuteIst` (minutes
// since IST midnight) are the sole stored form -- there is deliberately no
// parallel `"HH:mm"` string field, since two stored forms of the same fact
// can drift; a presentation format is derived on read, never persisted.
// `closeMinuteIst` is an EXCLUSIVE session boundary (see
// `exchange-calendar.types.ts` doc on `SessionWindow`).
model ExchangeCalendarSessionWindow {
  id             String              @id @default(uuid())
  calendarDayId  String
  windowIndex    Int
  openMinuteIst  Int
  closeMinuteIst Int
  createdAt      DateTime            @default(now())
  calendarDay    ExchangeCalendarDay @relation(fields: [calendarDayId], references: [id], onDelete: Cascade)

  @@unique([calendarDayId, windowIndex])
}

model ExecutionStateTransition {
  transitionId     String   @id
  executionOrderId String
  previousState    String?
  nextState        String
  timestamp        DateTime
  reason           String?
  correlationId    String
  createdAt        DateTime @default(now())
  order            ExecutionOrder @relation(fields: [executionOrderId], references: [executionOrderId], onDelete: Cascade)

  @@index([executionOrderId, timestamp])
}
